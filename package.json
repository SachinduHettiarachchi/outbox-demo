{
  "name": "outbox-demo",
  "version": "1.0.0",
  "description": "Minimal transactional outbox pattern implementation (Postgres + Node/TS)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "migrate": "ts-node src/migrate.ts",
    "dev": "ts-node src/index.ts",
    "server": "ts-node src/server.ts",
    "start": "node dist/index.js",
    "dlq:list": "ts-node src/dlqTool.ts list",
    "dlq:replay": "ts-node src/dlqTool.ts replay"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
